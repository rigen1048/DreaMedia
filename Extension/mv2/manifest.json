{
  "manifest_version": 2,
  "name": "DreaMedia",
  "description": "Subscribe from any YouTube page and track watch timestamps site-agnostically (D55).",
  "version": "1.0.0",
  "permissions": ["storage", "tabs", "activeTab", "alarms", "http://*/*", "https://*/*"],
  "browser_action": { "default_popup": "popup.html" },
  "background": { "scripts": ["background.js"], "persistent": true }
}
