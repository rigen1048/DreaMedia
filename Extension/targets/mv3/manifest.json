{
  "manifest_version": 3,
  "name": "DreaMedia",
  "description": "Subscribe from any YouTube page and track watch timestamps site-agnostically (D55).",
  "version": "1.0.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_icon": "icons/48.png", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" }
}
