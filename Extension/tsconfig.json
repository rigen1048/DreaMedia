{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist/types",
    "rootDir": "./",
    "types": ["chrome"]
  },
  "include": [
    "shared/**/*.ts",
    "Media/**/*.ts",
    "PopUI/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "targets",
    "tests"
  ]
}
