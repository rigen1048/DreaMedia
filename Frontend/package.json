{
  "name": "dreamedia-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "dev:static": "vite --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "build": "vite build",
    "build:static": "vite build",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.453.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "packageManager": "bun@1.3.1"
}
