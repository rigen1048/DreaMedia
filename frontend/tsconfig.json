{
  "include": ["client/src/**/*.ts", "client/src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "build", "dist", "backend/**"],
  "compilerOptions": {
    "target": "ES2022",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./client/src/*"] }
  }
}
