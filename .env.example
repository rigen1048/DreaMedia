# DreaMedia deployment facts (D2): paths/ports/credentials only.
# Policy values (cooldowns, ranks, floors) live in Config/Hardcoded/.

# Postgres connection — REQUIRED, no default. Compose and the app both
# read this same variable so they can never drift apart.
DREAMEDIA_PG_PASSWORD=

# Optional: full DSN override (defaults to 127.0.0.1:5432/dreamedia with
# user dreamedia and DREAMEDIA_PG_PASSWORD)
# DREAMEDIA_PG_DSN=

# Backup policy seeds (admin can change live at runtime; floors are hardcoded)
BACKUP_DIR=./backups
BACKUP_KEEP_LATEST=5
BACKUP_FREQUENCY_HOURS=24

# Stale-claim recovery window in seconds (D34); floor 300 is hardcoded
STALE_CLAIM_SECONDS=3600

# Access model (D54): 'wifi' = LAN-accessible (bind 0.0.0.0),
# 'computer' = localhost only (bind 127.0.0.1)
ACCESS=computer
# (start.py maps ACCESS → ACCESS_HOST for compose publish binding)

# Frontend: optional API target for the vite dev proxy
# DREAMEDIA_API_TARGET=http://127.0.0.1:8000
