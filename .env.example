# DreaMedia deployment facts (D2): paths/ports/credentials only.
# Policy values (cooldowns, ranks, floors) live in Config/Hardcoded/.

# Postgres connection — REQUIRED, no default. Compose and the app both
# read this same variable so they can never drift apart.
DREAMEDIA_PG_PASSWORD=

# Optional: full DSN override (defaults to the host/port below with user
# dreamedia and DREAMEDIA_PG_PASSWORD)
# DREAMEDIA_PG_DSN=
# Compose points these at the db service; local dev uses the defaults.
# DREAMEDIA_PG_HOST=127.0.0.1
# DREAMEDIA_PG_PORT=5432

# Backup policy seeds (admin can change live at runtime; floors are hardcoded)
BACKUP_DIR=./backups
BACKUP_KEEP_LATEST=5
BACKUP_FREQUENCY_HOURS=24

# Stale-claim recovery window in seconds (D34); floor 300 is hardcoded
STALE_CLAIM_SECONDS=3600

# Access model (D54): 'wifi' = LAN-accessible (bind 0.0.0.0),
# 'computer' = localhost only (bind 127.0.0.1)
ACCESS=computer
# (start.py maps ACCESS → ACCESS_HOST for compose publish binding)

# Frontend: optional API target for the vite dev proxy
# DREAMEDIA_API_TARGET=http://127.0.0.1:8123

# Extension reachability (D55): /ext/* rides the backend port (8000).
# ACCESS=wifi exposes it on the LAN — every call still needs a valid
# X-DreaMedia-Token (issue one in Settings → Browser extension).

# Bulk YouTube import workers per backend process. PostgreSQL enforces the
# shared global caps across all containers: 8 concurrent channel resolutions
# and 16 Add Source persistence operations. Resolver starts are spaced by
# 250ms, and each resolver slot waits 2s before reuse.
# Resolver tasks default to 8 (clamped to 1..8); processors default to 16
# (clamped to 1..16). Raising these values does not raise the global caps.
DREAMEDIA_YT_IMPORT_WORKERS=8
# DREAMEDIA_YT_IMPORT_PROCESS_WORKERS=16
