# Deployment facts ONLY (D2): no external-aggression policy values here.
# Rate limits, cooldowns, rank intervals live in Config/Hardcoded/.

# Postgres connection (used by the app outside docker, or inside compose)
DREAMEDIA_PG_DSN=postgresql://dreamedia:dreamedia-local-dev@127.0.0.1:5432/dreamedia

# Backup policy defaults (D13/D26): admin can change these at runtime via
# the admin API; these are just the first-boot seeds.
# Floors are hardcoded (Config/Hardcoded/limits.py): retention never < MIN_BACKUPS_KEPT.
BACKUP_DIR=./backups
BACKUP_KEEP_LATEST=5
BACKUP_FREQUENCY_HOURS=24
